BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5173
DATABASE_PATH=local.db

# OAuth sign-in (optional). Callback URLs: <BETTER_AUTH_URL>/api/auth/callback/github and /google
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OIDC sign-in (optional). Set the issuer and both credentials to enable it.
# Callback URL: <BETTER_AUTH_URL>/api/auth/callback/oidc
OIDC_PROVIDER_NAME=OpenID Connect
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
